{
  "name": "jailbreakchangelogs",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run generate:icons && next dev -p 5500",
    "build": "bun run generate:icons && next build",
    "build:analyze": "ANALYZE=true next build",
    "generate:icons": "bun scripts/generate-icon-bundle.ts && oxfmt --no-error-on-unmatched-pattern src/lib/icon-bundle.generated.ts",
    "analyze": "next experimental-analyze",
    "start": "next start -p 5500",
    "start:cf": "sh ./scripts/start-with-tunnel.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "test:sidebar-browser": "RUN_SIDEBAR_BROWSER_TESTS=1 bun test src/components/Layout/DesktopSidebar.browser.test.ts",
    "check": "bun run format:check && bun run type-check && bun run lint && bun run test",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "release": "bun --env-file=.env.local --bun release-it",
    "clean": "rm -rf .next node_modules && bun install",
    "bump-nextjs": "bunx @next/codemod upgrade latest",
    "prepare": "husky",
    "knip": "knip"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@iconify/react": "^6.0.2",
    "@iconify/types": "^2.0.0",
    "@marsidev/react-turnstile": "^1.6.1",
    "@number-flow/react": "^0.6.2",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "@twemoji/api": "^17.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "boring-avatars": "^2.0.4",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.16",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^7.5.0",
    "geist": "^1.7.2",
    "he": "^1.2.0",
    "modern-gif": "^2.1.0",
    "motion": "^12.43.0",
    "next": "^16.4.0",
    "nextjs-toploader": "^3.9.17",
    "nuqs": "^2.10.1",
    "radix-ui": "^1.6.7",
    "railway": "^3.12.0",
    "react": "^19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^15.0.0",
    "react-easy-crop": "^6.2.3",
    "react-markdown": "^10.1.0",
    "react-twemoji": "^0.7.2",
    "recharts": "3.10.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "schema-dts": "~2.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@iconify-json/akar-icons": "^1.2.7",
    "@iconify-json/emojione": "^1.2.3",
    "@iconify-json/fluent": "^1.2.59",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/heroicons-outline": "^1.2.1",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/logos": "^1.2.15",
    "@iconify-json/lucide": "^1.2.139",
    "@iconify-json/material-symbols": "^1.2.94",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/mingcute": "^1.2.8",
    "@iconify-json/noto-v1": "^1.2.5",
    "@iconify-json/rivet-icons": "^1.2.2",
    "@iconify-json/si": "^1.2.17",
    "@iconify-json/simple-icons": "^1.2.98",
    "@iconify-json/solar": "^1.2.13",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify/utils": "^3.1.7",
    "@release-it/conventional-changelog": "^12.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "~0.71.0",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.26",
    "release-it": "^20.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "browserslist": "> 1%",
  "version": "0.57.0",
  "engines": {
    "node": "24.x"
  }
}
